# ==============================================================================
# Gatekeeper Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
#   Copy-Item .env.example .env
#
# IMPORTANT:
# - Do NOT commit your active .env file to version control.
# - Replace placeholder values with your actual local credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL 8 Database Configuration (Docker Compose)
# ------------------------------------------------------------------------------
# Root password for the MySQL container (required by Docker Compose)
MYSQL_ROOT_PASSWORD=replace_with_local_mysql_root_password

# Database name automatically created at initialization
MYSQL_DATABASE=gatekeeper_management

# Application database user and password created by MySQL container
MYSQL_USER=gatekeeper
MYSQL_PASSWORD=replace_with_local_mysql_app_password

# ------------------------------------------------------------------------------
# 2. API Management Service (Control Plane - Port 8081)
# ------------------------------------------------------------------------------
# JDBC URL pointing to MySQL on host port 3306
GATEKEEPER_DB_URL=jdbc:mysql://localhost:3306/gatekeeper_management

# Database credentials used by Spring Boot on the host (matches MYSQL_USER / MYSQL_PASSWORD)
GATEKEEPER_DB_USERNAME=gatekeeper
GATEKEEPER_DB_PASSWORD=replace_with_local_mysql_app_password

# JWT Signing Secret for HMAC-SHA256
# MUST be at least 256 bits (32 ASCII characters or more)
GATEKEEPER_JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_characters_long

# ------------------------------------------------------------------------------
# 3. Smart Gateway Service (Data Plane - Port 8080)
# ------------------------------------------------------------------------------
# Service account credentials used by the Gateway to authenticate with Management API
# NOTE: Must match the seeded account in api-management-service V3 migration
GATEKEEPER_GATEWAY_USERNAME=gateway-service
GATEKEEPER_GATEWAY_PASSWORD=gateway123

# Base URL of the API Management Service control plane
GATEKEEPER_MANAGEMENT_URL=http://localhost:8081

# Scheduled route configuration synchronization interval in milliseconds (default: 10000 = 10s)
GATEKEEPER_CONFIGURATION_REFRESH_INTERVAL_MS=10000
